              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an organization"
        },
        {
          "info": {
            "name": "Delete an organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://files-api.dispatch.me/v3/organizations/:id",
