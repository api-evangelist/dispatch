{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dispatch Files API v1 Appointments Sources API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://files-api.dispatch.me/v3/sources",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return. Maximum value is 100."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip."
              }
            ]
          },
          "docs": "List sources"
        },
        {
          "info": {
            "name": "View a single source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://files-api.dispatch.me/v3/sources/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "View a single source"
        }
      ]
    }
  ],
  "bundled": true
}